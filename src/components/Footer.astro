---
import Icon from './Icon.astro';
import ContactForm from './ContactForm.astro';

interface Props {
  email: string;
  displayName: string;
  linkedin: string;
  /** Web3Forms access key; falls back to mailto when unset. */
  accessKey?: string;
}

const { email, displayName, linkedin, accessKey } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer__container">
    <div class="footer__text">
      <h2 class="footer__title">
        <span class="footer__mark" aria-hidden="true">✺</span>
        <span>let's connect</span>
      </h2>
      <p class="footer__subtitle">
        Feel free to reach out for collaborations or just say hi :)
      </p>
    </div>

    <div class="footer__columns">
      <div class="footer__socials-column">
        <nav class="footer__socials" aria-label="Social links">
          <a class="footer__social" href={`mailto:${email}`} title="Email">
            <Icon name="envelope" size="1.25rem" label="Email" />
          </a>
          <a
            class="footer__social"
            href={linkedin}
            target="_blank"
            rel="noopener noreferrer"
            title="LinkedIn"
          >
            <Icon name="linkedin" size="1.25rem" label="LinkedIn" />
          </a>
        </nav>
      </div>

      <div class="footer__form">
        <ContactForm
          email={email}
          displayName={displayName}
          accessKey={accessKey}
        />
      </div>
    </div>
  </div>

  <div class="footer__copyright">
    <p>© {year} all rights reserved</p>
  </div>
</footer>

<style>
  .footer {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--xxl);
    /* The form and copyright together own the last screen. */
    min-height: 100svh;
    padding: var(--xxl) var(--page-gutter) var(--xl);
    background: var(--color-background-footer);
    /* The footer surface is dark in both themes, so its text colors are fixed
       rather than theme-dependent. */
    color: var(--color-text-on-footer);
  }

  /* Heading first, then the socials and form side by side beneath it. */
  .footer__container {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: var(--xl);
    justify-content: center;
    width: 100%;
    max-width: var(--content-max-width);
    margin-inline: auto;
  }

  .footer__columns {
    display: flex;
    gap: var(--xxl);
    align-items: flex-start;
    width: 100%;
  }

  /* The 30/70 split is of the space left after the gap, so the two columns
     together never exceed the container. */
  .footer__socials-column {
    flex: 0 0 calc(30% - (var(--xxl) / 2));
  }

  /* The form sits at the right edge of its column, widening the gap
     between it and the socials. */
  /* The form sits at the right edge of its column, widening the gap
     between it and the socials. */
  .footer__form {
    display: flex;
    flex: 0 0 calc(70% - (var(--xxl) / 2));
    justify-content: flex-end;
  }

  .footer__text {
    display: flex;
    flex-direction: column;
  }

  .footer__title {
    display: flex;
    gap: var(--md);
    align-items: baseline;
    margin: 0;
    font-size: var(--font-size-64);
    font-weight: var(--font-weight-medium);
    line-height: var(--line-height-76-8);
    letter-spacing: var(--letter-spacing-2-56);
  }

  .footer__mark {
    font-weight: var(--font-weight-400);
  }

  .footer__subtitle {
    margin: 0;
    font-size: var(--font-size-16);
    font-weight: var(--font-weight-400);
    line-height: var(--line-height-24);
  }

  /* Icon-only links; the accessible name comes from the icon's label. */
  .footer__socials {
    display: flex;
    gap: var(--sm);
    align-items: center;
    margin-left: calc(var(--sm) * -1);
  }

  .footer__social {
    display: grid;
    place-items: center;
    padding: var(--sm);
    border-radius: 0.25rem;
    color: var(--color-text-on-footer);
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .footer__social:hover {
    opacity: 0.7;
  }

  /*
   * `border-style: dashed` gives no control over dash length or gap, so the
   * rule is a repeating gradient instead: --dash-length and --dash-gap are
   * both adjustable.
   */
  .footer__copyright {
    --dash-length: 0.125rem;
    --dash-gap: 0.375rem;

    width: 100%;
    max-width: var(--content-max-width);
    margin-inline: auto;
    padding-top: var(--lg);
    background-image: repeating-linear-gradient(
      to right,
      var(--color-border-footer) 0,
      var(--color-border-footer) var(--dash-length),
      transparent var(--dash-length),
      transparent calc(var(--dash-length) + var(--dash-gap))
    );
    background-repeat: no-repeat;
    background-size: 100% var(--stroke-weight-border);
    background-position: top left;
  }

  .footer__copyright p {
    margin: 0;
    font-family: var(--font-family-secondary);
    font-size: var(--font-size-14);
    line-height: var(--line-height-20);
    letter-spacing: var(--letter-spacing-0-28);
    text-transform: uppercase;
    /* #8d8d8d on #262626 is 4.56:1 — clears AA for this 14px text. */
    color: var(--color-text-on-footer-muted);
  }

  @media (max-width: 1100px) {
    .footer {
      padding-block: var(--xxl) var(--xl);
    }

    .footer__title {
      font-size: clamp(2.25rem, 7vw, 4rem);
      letter-spacing: -0.02em;
    }
  }

  /* The two columns stay side by side until there is genuinely no room for
     the form beside the heading. */
  @media (max-width: 820px) {
    .footer__container {
      flex-direction: column;
      gap: var(--xl);
      align-items: stretch;
      justify-content: center;
    }

    .footer__columns {
      flex-direction: column;
      gap: var(--xl);
    }

    .footer__form {
      flex-basis: auto;
      justify-content: flex-start;
      width: 100%;
    }
  }

  @media (max-width: 640px) {
    .footer {
      padding-block: var(--xl) var(--lg);
    }
  }
</style>
