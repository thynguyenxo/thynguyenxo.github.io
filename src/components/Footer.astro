---
import Icon from './Icon.astro';
import ContactForm from './ContactForm.astro';

interface Props {
  email: string;
  displayName: string;
  linkedin: string;
  /** Form service endpoint; falls back to mailto when unset. */
  formEndpoint?: string;
}

const { email, displayName, linkedin, formEndpoint } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer__container">
    <div class="footer__left">
      <div class="footer__text">
        <h2 class="footer__title">
          <span class="footer__mark" aria-hidden="true">✺</span>
          <span>let's connect</span>
        </h2>
        <p class="footer__subtitle">
          Feel free to reach out for collaborations or just say hi :)
        </p>
      </div>

      <nav class="footer__socials" aria-label="Social links">
        <a class="footer__social" href={`mailto:${email}`}>
          <Icon name="envelope" size="1rem" />
          <span>Email</span>
        </a>
        <a
          class="footer__social"
          href={linkedin}
          target="_blank"
          rel="noopener noreferrer"
        >
          <Icon name="linkedin" size="1rem" />
          <span>Linkedin</span>
        </a>
      </nav>
    </div>

    <div class="footer__right">
      <ContactForm
        email={email}
        displayName={displayName}
        endpoint={formEndpoint}
      />
    </div>
  </div>

  <div class="footer__copyright">
    <p>© {year} all rights reserved</p>
  </div>
</footer>

<style>
  .footer {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--xxl);
    /* The form and copyright together own the last screen. */
    min-height: 100svh;
    padding: var(--xxl) var(--footer-gutter) var(--xl);
    background: var(--color-background-footer);
    /* The footer surface is dark in both themes, so its text colors are fixed
       rather than theme-dependent. */
    color: var(--color-text-on-footer);
  }

  .footer__container {
    display: flex;
    flex: 1;
    gap: var(--xxl);
    align-items: center;
    justify-content: space-between;
    width: 100%;
    max-width: var(--content-max-width);
    margin-inline: auto;
  }

  .footer__left {
    display: flex;
    flex-direction: column;
    gap: var(--xl);
    justify-content: center;
  }

  .footer__text {
    display: flex;
    flex-direction: column;
  }

  .footer__title {
    display: flex;
    gap: var(--md);
    align-items: baseline;
    margin: 0;
    font-size: var(--font-size-64);
    font-weight: var(--font-weight-medium);
    line-height: var(--line-height-76-8);
    letter-spacing: var(--letter-spacing-2-56);
  }

  .footer__mark {
    font-weight: var(--font-weight-400);
  }

  .footer__subtitle {
    margin: 0;
    font-size: var(--font-size-16);
    font-weight: var(--font-weight-400);
    line-height: var(--line-height-24);
  }

  /* The socials now sit where the "Work with me" button used to. */
  .footer__socials {
    display: flex;
    align-items: center;
    margin-left: calc(var(--lg) * -1);
  }

  .footer__social {
    display: flex;
    gap: var(--item-spacing-8);
    align-items: center;
    padding: var(--sm) var(--lg);
    font-size: var(--font-size-16);
    font-weight: var(--font-weight-400);
    line-height: var(--line-height-24);
    color: var(--color-text-on-footer);
    text-decoration: none;
  }

  .footer__social:hover {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .footer__right {
    display: flex;
    flex: 0 1 30rem;
    justify-content: flex-end;
  }

  .footer__copyright {
    width: 100%;
    max-width: var(--content-max-width);
    margin-inline: auto;
    padding-top: var(--lg);
    border-top: var(--stroke-weight-border) dashed var(--color-border-footer);
  }

  .footer__copyright p {
    margin: 0;
    font-family: var(--font-family-secondary);
    font-size: var(--font-size-14);
    line-height: var(--line-height-20);
    letter-spacing: var(--letter-spacing-0-28);
    text-transform: uppercase;
    /* #8d8d8d on #262626 is 4.56:1 — clears AA for this 14px text. */
    color: var(--color-text-on-footer-muted);
  }

  @media (max-width: 1100px) {
    .footer {
      padding-block: var(--xxl) var(--xl);
    }

    .footer__container {
      flex-direction: column;
      gap: var(--xl);
      align-items: stretch;
      justify-content: center;
    }

    .footer__title {
      font-size: clamp(2.25rem, 7vw, 4rem);
      letter-spacing: -0.02em;
    }

    .footer__right {
      flex-basis: auto;
      justify-content: flex-start;
    }
  }

  @media (max-width: 640px) {
    .footer {
      padding-block: var(--xl) var(--lg);
    }
  }
</style>
