---
import ThemeToggle from './ThemeToggle.astro';
import teabag from '../assets/teabag.svg?raw';
import teabagPulled from '../assets/teabag-pulled.svg?raw';
---

<header class="navbar">
  <a class="navbar__identity" href="/" aria-label="Thy Nguyen, Product Designer — home">
    {/*
      Both states ship in the markup and CSS crossfades between them, so the
      swap is instant on hover with nothing to load mid-interaction.
    */}
    <span class="navbar__logo" aria-hidden="true">
      <span class="navbar__logo-state navbar__logo-state--rest" set:html={teabag} />
      <span
        class="navbar__logo-state navbar__logo-state--pulled"
        set:html={teabagPulled}
      />
    </span>
    <span class="navbar__intro">
      <span class="navbar__name-row">
        <span class="navbar__name">Thy Nguyen</span>
        <span class="navbar__pronunciation">/tea-win/</span>
      </span>
      <span class="navbar__role">Product designer</span>
    </span>
  </a>

  <div class="navbar__links">
    <ThemeToggle />
  </div>
</header>

<style>
  .navbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--md);
    width: 100%;
    max-width: var(--page-max-width);
    margin-inline: auto;
    padding: var(--lg) var(--page-gutter);
    background: var(--color-background-primary);
  }

  /* Centred rather than top-aligned: the logo is taller than the two lines
     of text beside it, so flex-start left it hanging below the role line. */
  .navbar__identity {
    display: flex;
    gap: var(--md);
    align-items: center;
    text-decoration: none;
  }

  .navbar__logo {
    position: relative;
    display: block;
    flex-shrink: 0;
    width: var(--navbar-logo-size);
    height: var(--navbar-logo-size);
    color: var(--color-text-main);
    /* Pivot at the top, so the motion reads as the bag hanging from its
       string rather than the whole square moving. */
    transform-origin: 50% 12%;
    /* Hangs at a slight angle at rest; the pull straightens it. */
    transform: rotate(8deg);
    /* Used on the way out: an unwound spring returning to rest. */
    transition: transform 0.45s cubic-bezier(0.34, 1.4, 0.64, 1);
  }

  /*
   * The two states stack, so swapping one for the other never shifts layout.
   *
   * Both are inlined in the markup, so nothing loads mid-interaction. The
   * fade overlaps the rotation instead of waiting for it: the swing spends
   * most of its time near level, so the shapes already coincide while the
   * crossfade runs, and there is no hold before the swap.
   */
  .navbar__logo-state {
    position: absolute;
    inset: 0;
    display: block;
    transition: opacity 0.3s ease;
  }

  /*
   * On the way in the pulled art leads slightly, so the mark never thins
   * mid-swap. The stagger is scoped to the hovered state: applied to the
   * base rule it also reverses on the way out, which made the logo dip to
   * half opacity as both fades crossed.
   */
  .navbar__identity:hover .navbar__logo-state--rest,
  .navbar__identity:focus-visible .navbar__logo-state--rest {
    transition-delay: 0.06s;
  }

  .navbar__identity:hover .navbar__logo-state--pulled,
  .navbar__identity:focus-visible .navbar__logo-state--pulled {
    transition-duration: 0.26s;
  }

  .navbar__logo-state--pulled {
    opacity: 0;
  }

  .navbar__identity:hover .navbar__logo-state--rest,
  .navbar__identity:focus-visible .navbar__logo-state--rest {
    opacity: 0;
  }

  .navbar__identity:hover .navbar__logo-state--pulled,
  .navbar__identity:focus-visible .navbar__logo-state--pulled {
    opacity: 1;
  }

  /*
   * A keyframed spring rather than a transition: a single cubic-bezier can
   * only overshoot once, which lands with a nudge. Dipping past the mark and
   * settling back in decreasing steps is what sells the pull.
   */
  .navbar__identity:hover .navbar__logo,
  .navbar__identity:focus-visible .navbar__logo {
    animation: logo-pull 0.5s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  /*
   * Straightens from the resting tilt to upright with a single small
   * overshoot. It reaches roughly level early and stays there, so the
   * crossfade can run alongside without the variants appearing misaligned.
   */
  @keyframes logo-pull {
    0% {
      transform: translateY(0) rotate(8deg);
    }
    35% {
      transform: translateY(3px) rotate(-1.6deg);
    }
    100% {
      transform: translateY(1.4px) rotate(0deg);
    }
  }

  /* Motion is decorative; the state swap alone still communicates the hover. */
  @media (prefers-reduced-motion: reduce) {
    .navbar__logo {
      transition: none;
    }

    .navbar__identity:hover .navbar__logo,
    .navbar__identity:focus-visible .navbar__logo {
      animation: none;
      transform: rotate(8deg);
    }

    .navbar__logo-state {
      transition: none;
    }
  }

  .navbar__logo :global(svg) {
    width: 100%;
    height: 100%;
  }

  .navbar__intro {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .navbar__name-row {
    display: flex;
    gap: var(--item-spacing-8);
    align-items: center;
  }

  .navbar__name {
    font-size: var(--font-size-24);
    font-weight: var(--font-weight-medium);
    line-height: var(--line-height-33-6);
    color: var(--color-text-main);
  }

  .navbar__pronunciation {
    font-size: var(--font-size-16);
    font-weight: var(--font-weight-400);
    line-height: var(--line-height-24);
    color: var(--color-text-secondary);
  }

  .navbar__role {
    font-family: var(--font-family-secondary);
    font-size: var(--font-size-14);
    font-weight: var(--font-weight-400);
    line-height: var(--line-height-20);
    letter-spacing: var(--letter-spacing-0-28);
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }

  .navbar__links {
    display: flex;
    gap: var(--lg);
    align-items: center;
  }

  @media (max-width: 640px) {
    .navbar {
      padding-block: var(--md);
    }

    .navbar__name {
      font-size: var(--font-size-18);
    }
  }
</style>
