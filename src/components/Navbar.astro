---
import ThemeToggle from './ThemeToggle.astro';
import logo from '../assets/logo.svg?raw';
---

<header class="navbar">
  <a class="navbar__identity" href="/" aria-label="Thy Nguyen, Product Designer — home">
    <span class="navbar__logo" aria-hidden="true" set:html={logo} />
    <span class="navbar__intro">
      <span class="navbar__name-row">
        <span class="navbar__name">Thy Nguyen</span>
        <span class="navbar__pronunciation">/tea-win/</span>
      </span>
      <span class="navbar__role">Product designer</span>
    </span>
  </a>

  <div class="navbar__links">
    <ThemeToggle />
  </div>
</header>

<style>
  .navbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--md);
    width: 100%;
    max-width: var(--page-max-width);
    margin-inline: auto;
    padding: var(--lg) var(--page-gutter);
    background: var(--color-background-primary);
  }

  /* Centred rather than top-aligned: the logo is taller than the two lines
     of text beside it, so flex-start left it hanging below the role line. */
  .navbar__identity {
    display: flex;
    gap: var(--md);
    align-items: center;
    text-decoration: none;
  }

  .navbar__logo {
    display: block;
    flex-shrink: 0;
    width: var(--navbar-logo-size);
    height: var(--navbar-logo-size);
    color: var(--color-text-main);
    /* Pivot near the top, so the tilt reads as the teabag swinging from its
       string rather than the whole square rotating. */
    transform-origin: 50% 15%;
    /* Used on the way out: an unwound spring returning to rest. */
    transition: transform 0.45s cubic-bezier(0.34, 1.4, 0.64, 1);
  }

  /*
   * On the way in, a keyframed spring rather than a transition: a single
   * cubic-bezier can only overshoot once, so it lands with a nudge. Swinging
   * past the mark and wobbling back in decreasing steps is what makes it feel
   * physical.
   */
  .navbar__identity:hover .navbar__logo,
  .navbar__identity:focus-visible .navbar__logo {
    animation: logo-swing 0.7s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  @keyframes logo-swing {
    0% {
      transform: rotate(0deg);
    }
    30% {
      transform: rotate(11deg);
    }
    55% {
      transform: rotate(5.5deg);
    }
    75% {
      transform: rotate(9deg);
    }
    90% {
      transform: rotate(7.4deg);
    }
    100% {
      transform: rotate(8deg);
    }
  }

  /* A tilt is decorative, so it is dropped entirely when motion is reduced. */
  @media (prefers-reduced-motion: reduce) {
    .navbar__logo {
      transition: none;
    }

    .navbar__identity:hover .navbar__logo,
    .navbar__identity:focus-visible .navbar__logo {
      animation: none;
      transform: none;
    }
  }

  .navbar__logo :global(svg) {
    width: 100%;
    height: 100%;
  }

  .navbar__intro {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .navbar__name-row {
    display: flex;
    gap: var(--item-spacing-8);
    align-items: center;
  }

  .navbar__name {
    font-size: var(--font-size-24);
    font-weight: var(--font-weight-medium);
    line-height: var(--line-height-33-6);
    color: var(--color-text-main);
  }

  .navbar__pronunciation {
    font-size: var(--font-size-16);
    font-weight: var(--font-weight-400);
    line-height: var(--line-height-24);
    color: var(--color-text-secondary);
  }

  .navbar__role {
    font-family: var(--font-family-secondary);
    font-size: var(--font-size-14);
    font-weight: var(--font-weight-400);
    line-height: var(--line-height-20);
    letter-spacing: var(--letter-spacing-0-28);
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }

  .navbar__links {
    display: flex;
    gap: var(--lg);
    align-items: center;
  }

  @media (max-width: 640px) {
    .navbar {
      padding-block: var(--md);
    }

    .navbar__name {
      font-size: var(--font-size-18);
    }
  }
</style>
