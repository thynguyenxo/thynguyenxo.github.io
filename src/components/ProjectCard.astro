---
import { Image } from 'astro:assets';

interface Props {
  client: string;
  title: string;
  description: string;
  image: ImageMetadata;
  imageAlt: string;
  href?: string;
}

const { client, title, description, image, imageAlt, href } = Astro.props;
---

<article class="card">
  <div class="card__description">
    <div class="card__container">
      <div class="card__client">
        <span class="card__client-name">{client}</span>
        <svg
          class="card__arrow"
          viewBox="0 0 24 24"
          width="24"
          height="24"
          aria-hidden="true"
          focusable="false"
        >
          <path
            d="M7 17 17 7M17 7H8M17 7v9"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </div>
      <h2 class="card__title">
        {
          href ? (
            <a class="card__link" href={href}>
              {title}
            </a>
          ) : (
            title
          )
        }
      </h2>
    </div>
    <p class="card__body">{description}</p>
  </div>

  <div class="card__image">
    <Image
      src={image}
      alt={imageAlt}
      widths={[880, 1760]}
      sizes="(max-width: 900px) 100vw, 880px"
      format="webp"
      quality={82}
      loading="lazy"
      decoding="async"
    />
  </div>
</article>

<style>
  .card {
    display: flex;
    gap: var(--xl);
    align-items: flex-end;
    width: 100%;
    max-width: var(--page-max-width);
    margin-inline: auto;
    padding-left: var(--xxl);
  }

  .card__description {
    display: flex;
    flex-direction: column;
    gap: var(--xl);
    justify-content: center;
    flex: 0 1 500px;
    max-width: 600px;
  }

  .card__container {
    display: flex;
    flex-direction: column;
    gap: var(--lg);
    justify-content: center;
  }

  .card__client {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .card__client-name {
    font-family: var(--font-family-secondary);
    font-size: var(--font-size-14);
    font-weight: var(--font-weight-400);
    line-height: var(--line-height-20);
    letter-spacing: var(--letter-spacing-0-28);
    text-transform: uppercase;
    color: var(--color-text-caption);
  }

  .card__arrow {
    flex-shrink: 0;
    width: 1.5rem;
    height: 1.5rem;
    color: var(--color-text-caption);
  }

  .card__title {
    margin: 0;
    font-size: var(--font-size-28);
    font-weight: var(--font-weight-regular);
    line-height: var(--line-height-39-2);
    letter-spacing: var(--letter-spacing-1-12);
    color: var(--color-text-main);
    text-wrap: pretty;
  }

  .card__link {
    text-decoration: none;
  }

  .card__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .card__body {
    margin: 0;
    font-size: var(--font-size-18);
    font-weight: var(--font-weight-400);
    line-height: var(--line-height-28);
    color: var(--color-text-secondary);
    text-wrap: pretty;
  }

  .card__image {
    position: relative;
    flex: 1 1 auto;
    width: 880px;
    max-width: 100%;
    height: 600px;
    overflow: hidden;
  }

  .card__image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  /* Below the design canvas the two columns stack: image first, then the
     description, so the visual still leads. */
  @media (max-width: 1100px) {
    .card {
      flex-direction: column-reverse;
      align-items: stretch;
      gap: var(--lg);
      padding-inline: var(--lg);
    }

    .card__description {
      flex-basis: auto;
      max-width: none;
    }

    .card__image {
      width: 100%;
      height: auto;
      aspect-ratio: 880 / 600;
    }
  }
</style>
