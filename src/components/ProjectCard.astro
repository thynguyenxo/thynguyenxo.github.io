---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';

interface Props {
  client: string;
  title: string;
  description: string;
  image: ImageMetadata;
  /** Optional dark-mode artwork; falls back to `image` when absent. */
  imageDark?: ImageMetadata;
  imageAlt: string;
  href?: string;
}

const { client, title, description, image, imageDark, imageAlt, href } =
  Astro.props;
---

<article class="card">
  <div class="card__description">
    <div class="card__container">
      <div class="card__client">
        <span class="card__client-name">{client}</span>
        <Icon name="arrow-right" size="1rem" class="card__arrow" />
      </div>
      <h2 class="card__title">
        {
          href ? (
            <a class="card__link" href={href}>
              {title}
            </a>
          ) : (
            title
          )
        }
      </h2>
    </div>
    <p class="card__body">{description}</p>
  </div>

  {/*
    Both artworks are rendered and CSS reveals the one matching the theme,
    so the toggle swaps them instantly with no flash and no JS.
  */}
  <div class="card__image">
    <Image
      class="card__art card__art--light"
      src={image}
      alt={imageAlt}
      widths={[880, 1760]}
      sizes="(max-width: 900px) 100vw, 880px"
      format="webp"
      quality={82}
      loading="lazy"
      decoding="async"
    />
    {
      imageDark && (
        <Image
          class="card__art card__art--dark"
          src={imageDark}
          alt=""
          aria-hidden="true"
          widths={[880, 1760]}
          sizes="(max-width: 900px) 100vw, 880px"
          format="webp"
          quality={82}
          loading="lazy"
          decoding="async"
        />
      )
    }
  </div>
</article>

<style>
  .card {
    /* Anchors the title link's ::after overlay, which makes the whole card
       clickable while keeping a single link in the accessibility tree. */
    position: relative;
    display: flex;
    gap: var(--xl);
    align-items: flex-end;
    width: 100%;
    max-width: var(--page-max-width);
    margin-inline: auto;
    /* Both edges use the page gutter, so the card lines up with the navbar
       and footer instead of the image bleeding to the viewport edge. */
    padding-inline: var(--page-gutter);
  }

  .card__description {
    display: flex;
    flex-direction: column;
    gap: var(--xl);
    justify-content: center;
    flex: 0 1 31.25rem;
    max-width: 37.5rem;
  }

  .card__container {
    display: flex;
    flex-direction: column;
    gap: var(--lg);
    justify-content: center;
  }

  .card__client {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .card__client-name {
    font-family: var(--font-family-secondary);
    font-size: var(--font-size-14);
    font-weight: var(--font-weight-400);
    line-height: var(--line-height-20);
    letter-spacing: var(--letter-spacing-0-28);
    text-transform: uppercase;
    color: var(--color-text-caption);
  }

  .card :global(.card__arrow) {
    color: var(--color-text-caption);
    transition: transform 0.2s ease;
  }

  .card__title {
    margin: 0;
    font-size: var(--font-size-28);
    font-weight: var(--font-weight-regular);
    line-height: var(--line-height-39-2);
    letter-spacing: var(--letter-spacing-1-12);
    color: var(--color-text-main);
    text-wrap: pretty;
  }

  .card__link {
    color: inherit;
    text-decoration: none;
  }

  /* Spans the whole card so the image and copy are both clickable. */
  .card__link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  /* The focus ring belongs on the whole card, not the inline text box, since
     the overlay is what visitors actually click. */
  .card__link:focus-visible {
    outline: none;
  }

  .card:has(.card__link:focus-visible) {
    outline: var(--stroke-weight-2) solid var(--color-text-main);
    outline-offset: 0.5rem;
    border-radius: 0.25rem;
  }

  .card:has(.card__link:hover) :global(.card__arrow) {
    transform: translateX(0.25rem);
  }

  .card__body {
    margin: 0;
    font-size: var(--font-size-18);
    font-weight: var(--font-weight-400);
    line-height: var(--line-height-28);
    color: var(--color-text-secondary);
    text-wrap: pretty;
  }

  .card__image {
    flex: 1 1 auto;
    width: 55rem;
    max-width: 100%;
    height: 34rem;
    overflow: hidden;
    border-radius: 1rem;
  }

  .card__image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  /* The two artworks share one grid cell so the box keeps its size. */
  .card__image:has(.card__art--dark) {
    display: grid;
    /* Safari can let a grid child paint over a rounded parent, so the clip is
       stated on the images too. */
    isolation: isolate;
  }

  .card__image :global(.card__art) {
    border-radius: inherit;
  }

  .card__image:has(.card__art--dark) :global(.card__art) {
    grid-area: 1 / 1;
  }

  :global(.card__art--dark) {
    display: none;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) :global(.card__art--light) {
      display: none;
    }

    :global(:root:not([data-theme='light'])) :global(.card__art--dark) {
      display: block;
    }
  }

  :global(:root[data-theme='dark']) :global(.card__art--light) {
    display: none;
  }

  :global(:root[data-theme='dark']) :global(.card__art--dark) {
    display: block;
  }

  :global(:root[data-theme='light']) :global(.card__art--light) {
    display: block;
  }

  :global(:root[data-theme='light']) :global(.card__art--dark) {
    display: none;
  }

  /* Below the design canvas the two columns stack: image first, then the
     description, so the visual still leads. */
  @media (max-width: 1100px) {
    .card {
      flex-direction: column-reverse;
      align-items: stretch;
      gap: var(--lg);
    }

    .card__description {
      flex-basis: auto;
      max-width: none;
    }

    .card__image {
      width: 100%;
      height: auto;
      aspect-ratio: 880 / 600;
    }
  }
</style>
