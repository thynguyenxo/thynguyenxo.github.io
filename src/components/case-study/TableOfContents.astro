---
/**
 * A quiet outline of the case study, pinned to the right edge.
 *
 * At rest it is a stack of short rules — enough to show how long the piece
 * is and where you are in it, without competing with the page. Pointing at
 * it opens the whole list rather than one name at a time, so the outline
 * can be read at a glance instead of hunted through.
 *
 * Hover is the only way in, so it is hidden entirely on narrow screens
 * where there is no pointer and no room for it.
 */
interface Props {
  items: { id: string; label: string }[];
}

const { items } = Astro.props;
---

{
  items.length > 0 && (
    <nav class="toc" aria-label="On this page" data-toc>
      {/*
        Two layers rather than one list of rows: the ticks stay in flow and
        keep their own rhythm, and the panel sits over them sized to the
        names. Neither has to line up with the other.
      */}
      <ul class="toc__ticks" aria-hidden="true">
        {items.map((item) => (
          <li>
            <span class="toc__rule" data-toc-rule={item.id} />
          </li>
        ))}
      </ul>

      <ul class="toc__panel">
        {items.map((item) => (
          <li>
            <a class="toc__link" href={`#${item.id}`} data-toc-link={item.id}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<style>
  .toc {
    position: fixed;
    top: 50%;
    right: 1.5rem;
    z-index: 9;
    transform: translateY(-50%);
    /* The rail is only a target while the pointer is over it; the gap it
       leaves beside the text should stay clickable for selection. */
    pointer-events: none;
  }

  /*
   * The ticks: a fixed 200px band whatever the section count, so the
   * outline sits in the same place on every case study.
   */
  .toc__ticks {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-end;
    height: 12.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
    pointer-events: auto;
  }

  /* Uniform apart from the current one, so the stack reads as a measure of
     the page rather than a list of links. */
  .toc__rule {
    display: block;
    width: 1rem;
    height: var(--stroke-weight-2);
    border-radius: var(--radius-pill);
    background: var(--color-border-bold);
    transition:
      width 0.2s ease,
      background-color 0.2s ease;
  }

  .toc__rule[data-current] {
    width: 1.5rem;
    background: var(--color-text-main);
  }

  /*
   * The panel: laid over the ticks and sized to its own names, so the two
   * layers need not share a rhythm. Anchored right so it grows leftward
   * into the margin as the names appear.
   */
  .toc__panel {
    position: absolute;
    top: 50%;
    right: 0;
    display: flex;
    flex-direction: column;
    gap: var(--sm);
    margin: 0;
    padding: var(--md);
    list-style: none;
    border: var(--stroke-weight-border) solid var(--color-border-secondary);
    border-radius: var(--radius-default);
    background: var(--color-background-primary);
    transform: translateY(-50%);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 0.2s ease,
      visibility 0.2s ease;
  }

  .toc:hover .toc__panel,
  .toc:focus-within .toc__panel {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .toc__link {
    display: block;
    white-space: nowrap;
    text-decoration: none;
    text-align: left;
    font-family: var(--font-family-primary);
    font-size: var(--font-size-12);
    line-height: var(--line-height-24);
    color: var(--color-text-secondary);
    transition: color 0.2s ease;
  }

  .toc__link:hover,
  .toc__link[data-current] {
    color: var(--color-text-main);
  }

  .toc__link:focus-visible {
    outline: var(--stroke-weight-2) solid var(--color-text-main);
    outline-offset: 0.25rem;
    border-radius: 0.125rem;
  }

  /*
   * TEMPORARY — holds the panel open so it can be styled without hovering.
   * Delete this block to restore hover-only behaviour before shipping.
   */
  .toc__panel {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .toc__rule,
    .toc__panel,
    .toc__link {
      transition: none;
    }
  }

  /*
   * Below the two column layout there is no rail to sit in, and no pointer
   * to open it with. Back to top already covers navigation there.
   */
  @media (max-width: 1100px) {
    .toc {
      display: none;
    }
  }
</style>

<script>
  /*
   * Marks the section currently in view on both layers: the tick shows it
   * at rest, the name shows it once the panel is open.
   */
  const links = document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]');

  if (links.length > 0) {
    const marks = new Map<string, Element[]>();
    for (const link of links) {
      const id = link.dataset.tocLink;
      if (!id) continue;
      const rule = document.querySelector(`[data-toc-rule="${id}"]`);
      marks.set(id, rule ? [link, rule] : [link]);
    }

    const sections = [...marks.keys()]
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => el !== null);

    let current: Element[] = [];

    const setCurrent = (id: string) => {
      const next = marks.get(id);
      if (!next || next === current) return;
      for (const el of current) el.removeAttribute('data-current');
      for (const el of next) el.setAttribute('data-current', '');
      current = next;
    };

    const observer = new IntersectionObserver(
      (entries) => {
        // Several sections can straddle the band at once; the highest one
        // on the page is the one being read.
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        if (visible[0]?.target.id) setCurrent(visible[0].target.id);
      },
      { rootMargin: '-10% 0px -60% 0px' },
    );

    for (const section of sections) observer.observe(section);
  }
</script>
