---
import { Image } from 'astro:assets';

/**
 * A media container: rounded surface holding an image or video, with an
 * optional caption beneath. Used for every visual in the case study.
 */
interface Props {
  /** Resolved image; omit to render a placeholder until artwork arrives. */
  image?: ImageMetadata;
  alt?: string;
  /** Client name shown before the slash in the caption. */
  captionClient?: string;
  /** Caption text after the slash. */
  caption?: string;
  /** Width / height of the media box. Defaults to the design's 1280x787. */
  ratio?: string;
  /** Full-bleed inside the container rather than inset. */
  wide?: boolean;
  /** Marks the slot as awaiting a video rather than a still. */
  video?: boolean;
}

const {
  image,
  alt = '',
  captionClient,
  caption,
  ratio = '1280 / 787',
  wide = false,
  video = false,
} = Astro.props;
---

<figure class:list={['media', wide && 'media--wide']}>
  <div class="media__frame" style={`--media-ratio:${ratio}`}>
    {
      image ? (
        <Image
          class="media__art"
          src={image}
          alt={alt}
          widths={[880, 1760]}
          sizes="(max-width: 900px) 100vw, 1200px"
          format="webp"
          quality={82}
          loading="lazy"
          decoding="async"
        />
      ) : (
        <div class="media__placeholder" aria-hidden="true">
          <span class="media__placeholder-note">
            {video ? 'Video' : 'Image'}
          </span>
        </div>
      )
    }
  </div>

  {
    (captionClient || caption) && (
      <figcaption class="media__caption">
        {captionClient && <span class="media__client">{captionClient}</span>}
        {captionClient && caption && <span class="media__sep"> / </span>}
        {caption && <span>{caption}</span>}
      </figcaption>
    )
  }
</figure>

<style>
  .media {
    display: flex;
    flex-direction: column;
    gap: var(--xl);
    margin: 0;
    width: 100%;
  }

  .media__frame {
    width: 100%;
    aspect-ratio: var(--media-ratio);
    overflow: hidden;
    border-radius: var(--radius-default);
    background: var(--color-background-secondary);
  }

  .media__frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Holds the frame's shape until the artwork arrives. */
  .media__placeholder {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
  }

  .media__placeholder-note {
    font-family: var(--font-family-secondary);
    font-size: var(--font-size-12);
    letter-spacing: var(--letter-spacing-0-28);
    text-transform: uppercase;
    color: var(--color-text-caption);
  }

  .media__caption {
    font-family: var(--font-family-secondary);
    font-size: var(--font-size-12);
    line-height: var(--line-height-20);
    letter-spacing: var(--letter-spacing-0-28);
    text-transform: uppercase;
    text-align: center;
    color: var(--color-text-caption);
  }

  .media__client {
    color: var(--color-text-main);
  }
</style>
