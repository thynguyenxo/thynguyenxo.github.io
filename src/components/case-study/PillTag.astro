---
/** Outlined pill that titles a section, e.g. the Preview block. */
---

<span class="pill"><slot /></span>

<style>
  .pill {
    display: inline-flex;
    align-items: center;
    padding: 0 var(--lg);
    border: var(--stroke-weight-border) solid var(--color-border-bold);
    border-radius: 62.4375rem;
    font-family: var(--font-family-secondary);
    font-size: var(--font-size-20);
    line-height: var(--line-height-20);
    letter-spacing: -0.12em;
    color: var(--color-text-main);
    height: 52px;
  }
</style>
