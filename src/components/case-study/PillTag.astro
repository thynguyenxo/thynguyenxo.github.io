---
/** Outlined pill that titles a section, e.g. the Preview block. */
---

<span class="pill"><slot /></span>

<style>
  .pill {
    display: inline-flex;
    align-items: center;
    padding: var(--md) var(--lg);
    border: var(--stroke-weight-border) solid var(--color-text-main);
    border-radius: 62.4375rem;
    font-size: var(--font-size-16);
    line-height: var(--line-height-24);
    color: var(--color-text-main);
  }
</style>
