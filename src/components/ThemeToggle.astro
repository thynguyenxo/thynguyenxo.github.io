---
import Icon from './Icon.astro';
---

<button
  type="button"
  class="theme-toggle"
  data-theme-toggle
  aria-pressed="false"
  title="Toggle dark mode"
>
  <span class="visually-hidden">Toggle dark mode</span>
  <Icon name="circle-half-stroke" size="1rem" class="theme-toggle__icon" />
</button>

<style>
  .theme-toggle {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
    color: var(--color-text-main);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  /* Rotate the filled half to mirror the active theme. */
  .theme-toggle :global(.theme-toggle__icon) {
    transition: transform 0.35s ease;
  }

  :global(:root[data-theme='dark']) .theme-toggle :global(.theme-toggle__icon) {
    transform: rotate(180deg);
  }
</style>
