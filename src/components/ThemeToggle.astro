---
// The navbar's brightness control. Figma shows a single filled circle; it is
// rendered here as a half-filled disc so the icon itself signals which way the
// switch goes, and it is a real <button> so it is keyboard reachable.
---

<button
  type="button"
  class="theme-toggle"
  data-theme-toggle
  aria-pressed="false"
  title="Toggle dark mode"
>
  <span class="visually-hidden">Toggle dark mode</span>
  <svg
    class="theme-toggle__icon"
    viewBox="0 0 16 16"
    width="16"
    height="16"
    aria-hidden="true"
    focusable="false"
  >
    <circle cx="8" cy="8" r="7.25" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
    <path d="M8 0.75 A7.25 7.25 0 0 1 8 15.25 Z" fill="currentColor"></path>
  </svg>
</button>

<style>
  .theme-toggle {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
    color: var(--color-text-main);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .theme-toggle__icon {
    width: 1rem;
    height: 1rem;
    transition: transform 0.35s ease;
  }

  /* Rotate the filled half to mirror the active theme. */
  :global(:root[data-theme='dark']) .theme-toggle__icon {
    transform: rotate(180deg);
  }
</style>
