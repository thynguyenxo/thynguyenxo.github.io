---
// Display type from the Figma hero.
//
// The headline paints in the primary color at rest. From "through" onward each
// letter shifts to tertiary in turn as the page scrolls, so the design's
// two-tone treatment resolves progressively rather than being the start state.

const LEAD = 'I enjoy designing intuitive and polished digital products that help people — ';
const FADED = 'through visual clarity and systems thinking';

// Split into words so a word never breaks across lines, then into letters so
// each can carry its own point in the sweep.
const words = FADED.split(' ');
const letterCount = FADED.replace(/ /g, '').length;

let letterIndex = 0;
const wordSpans = words.map((word) => {
  const letters = [...word].map((char) => ({ char, index: letterIndex++ }));
  return letters;
});
---

<section class="hero">
  <h1 class="hero__headline">
    {LEAD}<span class="hero__fade" data-hero-fade style={`--letter-count:${letterCount}`}
      >{
        wordSpans.map((letters, wordIndex) => (
          <Fragment>
            <span class="hero__word">
              {letters.map(({ char, index }) => (
                <span class="hero__letter" style={`--letter-index:${index}`}>{char}</span>
              ))}
            </span>
            {wordIndex < wordSpans.length - 1 ? ' ' : ''}
          </Fragment>
        ))
      }</span
    >
  </h1>
</section>

<style>
  /* Registered so the browser interpolates it as a number rather than
     flipping it at the halfway point. Declared in CSS so it applies at parse
     time, with no dependency on a script having run first. */
  @property --hero-fade-progress {
    syntax: '<number>';
    inherits: true;
    initial-value: 0;
  }

  /* The navbar and hero together fill the first screen: the hero takes the
     viewport height minus whatever the navbar occupies, so the headline sits
     centred in the space that remains. */
  .hero {
    display: flex;
    flex-direction: column;
    gap: var(--xxl);
    justify-content: center;
    width: 100%;
    min-height: calc(100svh - var(--navbar-height, 0px));
    max-width: var(--page-max-width);
    margin-inline: auto;
    padding: 0 var(--page-gutter) var(--xxl);
  }

  .hero__headline {
    max-width: 25ch;
    margin: 0;
    font-size: var(--font-size-64);
    font-weight: var(--font-weight-regular);
    line-height: var(--line-height-76-8);
    letter-spacing: var(--letter-spacing-2-56);
    color: var(--color-text-main);
  }

  /* Keeps each word intact when the headline wraps. The spaces between words
     are real text nodes outside these spans, so spacing and wrapping behave
     exactly as they would in an unsplit headline. */
  .hero__word {
    white-space: nowrap;
  }


  /*
   * Each letter converts the shared scroll progress into its own 0→1 value.
   * `--letter-start` staggers them across the sweep, and `--letter-span`
   * controls how much of the scroll a single letter takes to change — wider
   * than the gap between letters, so neighbours overlap and the sweep reads
   * as continuous rather than as a row of switches.
   */
  .hero__letter {
    --letter-start: calc(var(--letter-index) / var(--letter-count));
    --letter-span: 0.1;
    --letter-progress: clamp(
      0,
      calc(
        (var(--hero-fade-progress, 0) - var(--letter-start) * (1 - var(--letter-span))) /
          var(--letter-span)
      ),
      1
    );

    /* Plain color first, so a browser that cannot parse the mix still shows
       the resting primary color instead of dropping the declaration. */
    color: var(--color-text-main);
    color: color-mix(
      in oklab,
      var(--color-text-tertiary) calc(var(--letter-progress) * 100%),
      var(--color-text-main)
    );
  }

  /*
   * Scroll-driven animation where available: no JS, and it runs off the main
   * thread. The fallback listener below stays inert when this applies.
   */
  @supports (animation-timeline: scroll()) {
    .hero__fade {
      animation: hero-fade-sweep linear both;
      animation-timeline: scroll(root block);
      /* Completes within the first 15svh, so the wash tracks the scroll
         almost immediately. Much below this the letters flip near enough
         together that the left-to-right wave stops reading. */
      animation-range: 0 15svh;
    }

    @keyframes hero-fade-sweep {
      from {
        --hero-fade-progress: 0;
      }
      to {
        --hero-fade-progress: 1;
      }
    }
  }

  /* Respect a reduced-motion preference by settling on the design's resting
     two-tone state immediately. */
  @media (prefers-reduced-motion: reduce) {
    .hero__fade {
      animation: none;
      --hero-fade-progress: 1;
    }

    .hero__letter {
      color: var(--color-text-tertiary);
    }
  }

  /* The display size is fluid below the design canvas so the headline keeps
     its proportions instead of overflowing. */
  @media (max-width: 1100px) {
    .hero__headline {
      font-size: clamp(3rem, 5.8vw, 4rem);
    }
  }

  @media (max-width: 640px) {
    .hero {
      padding-bottom: var(--xl);
    }

    .hero__headline {
      letter-spacing: -0.02em;
    }
  }
</style>

<script>
  // Fallback for browsers without scroll-driven animations. Skipped when the
  // CSS above is doing the work, and when the visitor prefers reduced motion.
  const supportsScrollTimeline =
    typeof CSS !== 'undefined' && CSS.supports('animation-timeline: scroll()');
  const prefersReducedMotion = window.matchMedia(
    '(prefers-reduced-motion: reduce)'
  ).matches;

  if (!supportsScrollTimeline && !prefersReducedMotion) {
    const fade = document.querySelector<HTMLElement>('[data-hero-fade]');

    if (fade) {
      let ticking = false;

      const update = () => {
        ticking = false;
        // Matches the CSS range above.
        const range = window.innerHeight * 0.15;
        const progress = range > 0 ? Math.min(window.scrollY / range, 1) : 1;
        fade.style.setProperty('--hero-fade-progress', String(progress));
      };

      const onScroll = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(update);
      };

      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
      update();
    }
  }
</script>
