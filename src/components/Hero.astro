---
// Display type from the Figma hero. The closing phrase starts in the primary
// text color and fades to tertiary as the page scrolls, so the two-tone
// treatment in the design becomes the resting state rather than the initial one.
---

<section class="hero">
  <h1 class="hero__headline">
    I enjoy designing intuitive and polished digital products that help people
    — through <span class="hero__accent" data-hero-accent
      >visual clarity and systems thinking</span
    >
  </h1>
</section>

<style>
  /* The navbar and hero together fill the first screen: the hero takes the
     viewport height minus whatever the navbar occupies, so the headline sits
     centred in the space that remains. */
  .hero {
    display: flex;
    flex-direction: column;
    gap: var(--xxl);
    justify-content: center;
    width: 100%;
    min-height: calc(100svh - var(--navbar-height, 0px));
    max-width: var(--page-max-width);
    margin-inline: auto;
    padding: 0 var(--page-gutter) var(--xxl);
  }

  .hero__headline {
    max-width: 25ch;
    margin: 0;
    font-size: var(--font-size-64);
    font-weight: var(--font-weight-regular);
    line-height: var(--line-height-76-8);
    letter-spacing: var(--letter-spacing-2-56);
    color: var(--color-text-main);
  }

  /*
   * Starts at the headline color and lands on tertiary. `--hero-accent-progress`
   * is driven by scroll — by the animation-timeline below where it is
   * supported, and by a small scroll listener everywhere else.
   */
  .hero__accent {
    color: color-mix(
      in oklab,
      var(--color-text-tertiary) calc(var(--hero-accent-progress, 0) * 100%),
      var(--color-text-main)
    );
  }

  /*
   * Scroll-driven animation where available: no JS, and it runs on the
   * compositor. The fallback listener below stays inert when this applies.
   */
  @supports (animation-timeline: view()) {
    .hero__accent {
      animation: hero-accent-fade linear both;
      animation-timeline: view();
      /* Complete the change over the first stretch of the scroll out. */
      animation-range: exit-crossing 0% exit-crossing 60%;
    }

    @keyframes hero-accent-fade {
      from {
        --hero-accent-progress: 0;
      }
      to {
        --hero-accent-progress: 1;
      }
    }
  }

  /* Respect a reduced-motion preference by settling on the design's resting
     two-tone state immediately. */
  @media (prefers-reduced-motion: reduce) {
    .hero__accent {
      animation: none;
      color: var(--color-text-tertiary);
    }
  }

  /* The display size is fluid below the design canvas so the headline keeps
     its proportions instead of overflowing. */
  @media (max-width: 1100px) {
    .hero__headline {
      font-size: clamp(2.25rem, 5.8vw, 4rem);
    }
  }

  @media (max-width: 640px) {
    .hero {
      padding-bottom: var(--xl);
    }

    .hero__headline {
      letter-spacing: -0.02em;
    }
  }
</style>

<script>
  // `--hero-accent-progress` is a plain custom property, so it needs
  // registering before it can be interpolated rather than flipping at 50%.
  if (typeof CSS !== 'undefined' && 'registerProperty' in CSS) {
    try {
      CSS.registerProperty({
        name: '--hero-accent-progress',
        syntax: '<number>',
        inherits: false,
        initialValue: '0',
      });
    } catch {
      // Already registered on a soft navigation — nothing to do.
    }
  }

  // Fallback for browsers without scroll-driven animations. Skipped when the
  // CSS above is doing the work, and when the visitor prefers reduced motion.
  const supportsScrollTimeline =
    typeof CSS !== 'undefined' && CSS.supports('animation-timeline: view()');
  const prefersReducedMotion = window.matchMedia(
    '(prefers-reduced-motion: reduce)'
  ).matches;

  if (!supportsScrollTimeline && !prefersReducedMotion) {
    const accent = document.querySelector<HTMLElement>('[data-hero-accent]');
    const hero = document.querySelector<HTMLElement>('.hero');

    if (accent && hero) {
      let ticking = false;

      const update = () => {
        ticking = false;
        // Progress runs 0 → 1 across the first 60% of scrolling the hero away.
        const range = hero.offsetHeight * 0.6;
        const progress = range > 0 ? Math.min(window.scrollY / range, 1) : 1;
        accent.style.setProperty('--hero-accent-progress', String(progress));
      };

      const onScroll = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(update);
      };

      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
      update();
    }
  }
</script>
