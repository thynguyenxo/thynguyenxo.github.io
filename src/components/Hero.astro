---
// Display type from the Figma hero. The closing line is rendered in
// text/tertiary, matching the design's two-tone treatment.
---

<section class="hero">
  <h1 class="hero__headline">
    I enjoy designing intuitive and polished digital products that help people
    — through <span class="hero__accent">visual clarity and systems thinking</span>
  </h1>
</section>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    gap: var(--xxl);
    justify-content: center;
    width: 100%;
    max-width: var(--page-max-width);
    margin-inline: auto;
    padding: 0 var(--xxl) var(--xxl);
  }

  .hero__headline {
    /* Sized to reproduce the design's four-line break pattern at the 1200px
       canvas; below that the clamp below takes over and it reflows. */
    max-width: 17.5ch;
    margin: 0;
    font-size: var(--font-size-64);
    font-weight: var(--font-weight-regular);
    line-height: var(--line-height-76-8);
    letter-spacing: var(--letter-spacing-2-56);
    color: var(--color-text-main);
  }

  .hero__accent {
    color: var(--color-text-tertiary);
  }

  /* The display size is fluid below the 1200px canvas so the headline keeps
     its proportions instead of overflowing. */
  @media (max-width: 1100px) {
    .hero__headline {
      font-size: clamp(2.25rem, 5.8vw, 4rem);
      max-width: 22ch;
    }
  }

  @media (max-width: 640px) {
    .hero {
      padding: 0 var(--lg) var(--xl);
    }

    .hero__headline {
      letter-spacing: -0.02em;
    }
  }
</style>
