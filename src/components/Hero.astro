---
// Display type from the Figma hero. The closing line is rendered in
// text/tertiary, matching the design's two-tone treatment.
---

<section class="hero">
  <h1 class="hero__headline">
    I enjoy designing intuitive and polished digital products that help people
    — through <span class="hero__accent">visual clarity and systems thinking</span>
  </h1>
</section>

<style>
  /* The navbar and hero together fill the first screen: the hero takes the
     viewport height minus whatever the navbar occupies, so the headline sits
     centred in the space that remains. */
  .hero {
    display: flex;
    flex-direction: column;
    gap: var(--xxl);
    justify-content: center;
    width: 100%;
    min-height: calc(100svh - var(--navbar-height, 0px));
    max-width: var(--page-max-width);
    margin-inline: auto;
    padding: 0 var(--page-gutter) var(--xxl);
  }

  .hero__headline {
    max-width: 25ch;
    margin: 0;
    font-size: var(--font-size-64);
    font-weight: var(--font-weight-regular);
    line-height: var(--line-height-76-8);
    letter-spacing: var(--letter-spacing-2-56);
    color: var(--color-text-main);
  }

  .hero__accent {
    color: var(--color-text-tertiary);
  }

  /* The display size is fluid below the 1200px canvas so the headline keeps
     its proportions instead of overflowing. */
  @media (max-width: 1100px) {
    .hero__headline {
      font-size: clamp(2.25rem, 5.8vw, 4rem);
      max-width: 22ch;
    }
  }

  @media (max-width: 640px) {
    .hero {
      padding-bottom: var(--xl);
    }

    .hero__headline {
      letter-spacing: -0.02em;
    }
  }
</style>
