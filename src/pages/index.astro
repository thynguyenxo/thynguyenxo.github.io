---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Footer from '../components/Footer.astro';
import { site, projects } from '../data/site';

// Eagerly resolved so each project's cover can be looked up by its `cover`
// path at build time.
const covers = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/**/*.{png,jpg,jpeg,webp,avif}',
  { eager: true }
);
---

<BaseLayout title={`${site.name} — Product Designer`}>
  <Navbar />

  <main class="main">
    <Hero />

    <section class="projects" aria-label="Selected work">
      {
        projects.map((project) => (
          <ProjectCard
            client={project.client}
            tagline={project.tagline}
            title={project.title}
            description={project.description}
            image={
              project.cover
                ? covers[`../assets/${project.cover}`].default
                : undefined
            }
            imageDark={
              project.coverDark
                ? covers[`../assets/${project.coverDark}`].default
                : undefined
            }
            imageAlt={project.coverAlt}
            href={`/${project.slug}`}
          />
        ))
      }
    </section>
  </main>

  <Footer
    email={site.email}
    displayName={site.name}
    linkedin={site.linkedin}
    accessKey={site.formAccessKey || undefined}
  />
</BaseLayout>

<style>
  /* No padding above the hero: it measures itself against the viewport, so
     any leading space here would push it past the fold. */
  .main {
    display: flex;
    flex-direction: column;
    gap: var(--3xl);
    align-items: center;
    padding-block: 0;
    overflow: clip;
    background: var(--color-background-primary);
  }

  .projects {
    display: flex;
    flex-direction: column;
    width: 100%;
    /* Separates the last card from the footer. */
    padding-bottom: var(--3xl);
  }

  @media (max-width: 1100px) {
    .main {
      gap: var(--xxl);
    }

    .projects {
      padding-block: var(--xl);
    }
  }
</style>
