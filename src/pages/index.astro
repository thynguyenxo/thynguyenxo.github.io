---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Footer from '../components/Footer.astro';
import tenminImage from '../assets/figma/tenmin.png';

const projects = [
  {
    client: 'Tenmin',
    title: 'Reimagined the onboarding experience to build trust with an AI tutor',
    description:
      'I designed the onboarding experience for an AI-powered language learning mobile app that helps build emotional trust with an AI tutor and a review screen that makes daily practice feel effortless and rewarding.',
    image: tenminImage,
    imageAlt:
      'Three Tenmin app screens showing the speaking-practice onboarding flow',
  },
];
---

<BaseLayout title="Thy Nguyen">
  <Navbar />

  <main class="main">
    <Hero />

    <section class="projects" aria-label="Selected work">
      {projects.map((project) => <ProjectCard {...project} />)}
    </section>
  </main>

  <Footer email="thynguyenxo@gmail.com" linkedin="https://www.linkedin.com/" />
</BaseLayout>

<style>
  .main {
    display: flex;
    flex-direction: column;
    gap: var(--3xl);
    align-items: center;
    padding-block: var(--xxl);
    overflow: clip;
    background: var(--color-background-primary);
  }

  .projects {
    display: flex;
    flex-direction: column;
    gap: var(--xxl);
    width: 100%;
    padding-block: var(--xxl);
  }

  @media (max-width: 1100px) {
    .main {
      gap: var(--xxl);
    }

    .projects {
      padding-block: var(--xl);
    }
  }
</style>
