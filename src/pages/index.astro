---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Footer from '../components/Footer.astro';
import { site, projects } from '../data/site';

// Eagerly resolved so each project's cover can be looked up by its `cover`
// path at build time.
const covers = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/**/*.{png,jpg,jpeg,webp,avif}',
  { eager: true }
);
---

<BaseLayout title={site.name}>
  <Navbar />

  <main class="main">
    <Hero />

    <section class="projects" aria-label="Selected work">
      {
        projects.map((project) => (
          <ProjectCard
            client={project.client}
            title={project.title}
            description={project.description}
            image={covers[`../assets/${project.cover}`].default}
            imageAlt={project.coverAlt}
            href={`/${project.slug}`}
          />
        ))
      }
    </section>
  </main>

  <Footer email={site.email} linkedin={site.linkedin} />
</BaseLayout>

<style>
  .main {
    display: flex;
    flex-direction: column;
    gap: var(--3xl);
    align-items: center;
    padding-block: var(--xxl);
    overflow: clip;
    background: var(--color-background-primary);
  }

  .projects {
    display: flex;
    flex-direction: column;
    gap: var(--xxl);
    width: 100%;
    padding-block: var(--xxl);
  }

  @media (max-width: 1100px) {
    .main {
      gap: var(--xxl);
    }

    .projects {
      padding-block: var(--xl);
    }
  }
</style>
