---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import SectionLabel from '../components/case-study/SectionLabel.astro';
import PillTag from '../components/case-study/PillTag.astro';
import MediaBlock from '../components/case-study/MediaBlock.astro';
import Dialog from '../components/case-study/Dialog.astro';
import { site, projects } from '../data/site';

// One page per entry in `projects`, so a new project needs no new route file.
export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const study = project.study;

const covers = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/**/*.{png,jpg,jpeg,webp,avif}',
  { eager: true }
);
const cover = covers[`../assets/${project.cover}`].default;
---

<BaseLayout
  title={`${site.name} — ${project.client}`}
  description={project.description}
>
  <Navbar />

  <main class="study">
    <div class="study__container">
      <div class="study__thumbnail">
        <Image
          src={cover}
          alt={project.coverAlt}
          widths={[880, 1440, 2880]}
          sizes="(max-width: 1440px) 100vw, 1280px"
          format="webp"
          quality={82}
          loading="eager"
          fetchpriority="high"
        />
      </div>

      {
      study ? (
        <div class="study__body">
          <section class="intro" aria-label="Project overview">
            <div class="intro__about">
              <div class="intro__title">
                <h1 class="intro__name">{project.client}</h1>
                <SectionLabel>{study.standfirst}</SectionLabel>
              </div>

              <div class="intro__columns">
                {study.intro.map((paragraph) => (
                  <p class="intro__paragraph">{paragraph}</p>
                ))}
              </div>
            </div>

            <dl class="intro__facts">
              {study.facts.map((fact) => (
                <div class="intro__fact">
                  <dt>
                    <SectionLabel>{fact.label}</SectionLabel>
                  </dt>
                  {fact.values.map((value) => (
                    <dd class="intro__value">{value}</dd>
                  ))}
                </div>
              ))}
            </dl>
          </section>

          <section class="preview" aria-label="Preview">
            <PillTag>{study.preview.tag}</PillTag>
            <MediaBlock
              captionClient={project.client}
              caption={study.preview.caption}
            />
          </section>

          <section class="problem" aria-label={study.problem.label}>
            <div class="problem__text">
              <SectionLabel>{study.problem.label}</SectionLabel>
              {study.problem.body.map((paragraph) => (
                <p class="problem__paragraph">{paragraph}</p>
              ))}
            </div>

            <Dialog label={study.problem.dialog.label}>
              {study.problem.dialog.question}
            </Dialog>
          </section>
        </div>
      ) : (
        <div class="study__body">
          <section class="problem">
            <SectionLabel>{project.client}</SectionLabel>
            <p class="problem__paragraph">{project.description}</p>
          </section>
        </div>
      )
    }

      <nav class="study__nav" aria-label="Project navigation">
        <a class="study__back" href="/">← Back to all work</a>
      </nav>
    </div>
  </main>

  <Footer
    email={site.email}
    displayName={site.name}
    linkedin={site.linkedin}
    accessKey={site.formAccessKey || undefined}
  />
</BaseLayout>

<style>
  .study {
    background: var(--color-background-primary);
  }

  /* One container holds everything below the navbar, so the thumbnail shares
     the same 80px inset as the write-up beneath it. */
  .study__container {
    width: 100%;
    max-width: var(--page-max-width);
    margin-inline: auto;
    padding-inline: var(--xxl);
  }

  /* The navbar and hero together fill the first screen: the thumbnail takes
     the viewport height minus whatever the navbar occupies. */
  .study__thumbnail {
    width: 100%;
    height: calc(100svh - var(--navbar-height, 0px));
    overflow: hidden;
    border-radius: var(--radius-default);
  }

  .study__thumbnail :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* The container above already applies the page inset, so this only spaces
     the sections vertically. */
  .study__body {
    display: flex;
    flex-direction: column;
    gap: var(--3xl);
    width: 100%;
    padding-block: var(--xxl);
  }

  /* Intro: the write-up on the left, a metadata rail on the right. */
  .intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 20rem;
    gap: var(--xxl);
    align-items: start;
  }

  .intro__about {
    display: flex;
    flex-direction: column;
    gap: var(--xl);
  }

  .intro__title {
    display: flex;
    flex-direction: column;
    gap: var(--sm);
  }

  .intro__name {
    margin: 0;
    font-size: var(--font-size-28);
    font-weight: var(--font-weight-medium);
    line-height: var(--line-height-44-on-28);
    letter-spacing: var(--letter-spacing-0-8);
    color: var(--color-text-main);
  }

  .intro__columns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--xl);
  }

  .intro__paragraph {
    margin: 0;
    font-size: var(--font-size-16);
    line-height: var(--line-height-28);
    color: var(--color-text-primary);
    text-wrap: pretty;
  }

  .intro__facts {
    display: flex;
    flex-direction: column;
    gap: var(--lg);
    margin: 0;
    padding-top: var(--xl);
  }

  .intro__fact {
    display: flex;
    flex-direction: column;
    gap: var(--item-spacing-xxs);
  }

  .intro__value {
    margin: 0;
    font-size: var(--font-size-16);
    line-height: var(--line-height-28);
    color: var(--color-text-primary);
  }

  /* Preview: pill, media, caption. */
  .preview {
    display: flex;
    flex-direction: column;
    gap: var(--xl);
    align-items: flex-start;
  }

  /* Problem: narrower measure than the full page, per the design. */
  .problem {
    display: flex;
    flex-direction: column;
    gap: var(--xxl);
    width: 100%;
    max-width: 55rem;
    margin-inline: auto;
  }

  .problem__text {
    display: flex;
    flex-direction: column;
    gap: var(--lg);
  }

  .problem__paragraph {
    margin: 0;
    font-size: var(--font-size-18);
    line-height: var(--line-height-28);
    color: var(--color-text-primary);
    text-wrap: pretty;
  }

  .study__nav {
    width: 100%;
    padding-bottom: var(--xxl);
  }

  .study__back {
    font-size: var(--font-size-16);
    line-height: var(--line-height-24);
    color: var(--color-text-main);
    text-decoration: none;
  }

  .study__back:hover {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  @media (max-width: 1100px) {
    .study__container {
      padding-inline: var(--xl);
    }

    .study__body {
      gap: var(--xxl);
      padding-block: var(--xl);
    }

    .intro {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--xl);
    }

    .intro__facts {
      flex-direction: row;
      flex-wrap: wrap;
      gap: var(--xl);
      padding-top: 0;
    }
  }

  @media (max-width: 640px) {
    .intro__columns {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
